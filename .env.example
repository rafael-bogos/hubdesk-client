# URL do backend hubdesk-server. Server-only: nunca prefixar com NEXT_PUBLIC_,
# essa variável não deve ser exposta ao bundle do navegador.
BACKEND_API_URL=http://localhost:3001

# Exceção deliberada à regra acima: o Socket.io de notificações em tempo real
# precisa que o navegador conecte direto no backend (ver decisão registrada
# na sessão de implementação), então essa aqui É pública de propósito.
NEXT_PUBLIC_BACKEND_WS_URL=http://localhost:3001
